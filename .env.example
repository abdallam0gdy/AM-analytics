# AM Analytics Environment Variables
# Copy this file to .env and fill in your values

# === Supabase ===
# أنشئ مشروع على https://supabase.com ثم انسخ القيم من Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# === Gemini AI ===
# احصل عليه من: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === YouTube Data API v3 (للـ Pipeline فقط) ===
# احصل عليه من: https://console.cloud.google.com/apis/credentials
# فعّل "YouTube Data API v3" أولاً
YOUTUBE_API_KEY=your_youtube_api_key_here
